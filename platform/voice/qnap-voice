#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# /usr/local/sbin/qnap-voice - spoken status prompts for the QNAP TS-328
#
# Usage: qnap-voice boot|shutdown|poweroff|test
#
# Plays /usr/local/share/qnap-voice/<prompt>.wav on the speaker (ALSA card
# "RTD1295", the rtd1295-ao driver). Without that card it falls back to
# the front-panel buzzer of the MCU (qnap-mcu input device, EV_SND).
# Settings: /etc/default/qnap-voice (VOLUME=0..31, VOICE=no to disable).

set -u
SOUNDS=/usr/local/share/qnap-voice
CARD=RTD1295
VOLUME=
VOICE=yes
[ -r /etc/default/qnap-voice ] && . /etc/default/qnap-voice
[ "$VOICE" = no ] && exit 0

case "${1:-}" in
boot)		file=boot-complete; beeps=tone ;;
shutdown)	file=shutting-down; beeps=bell ;;
poweroff)	file=powering-down; beeps="tone tone" ;;
test)		file=test-tone-1k; beeps=tone ;;
*)		echo "usage: qnap-voice boot|shutdown|poweroff|test" >&2; exit 2 ;;
esac

# "shutdown" comes from ExecStop: only speak if the system is going down
if [ "$1" = shutdown ] && command -v systemctl >/dev/null; then
	systemctl list-jobs --no-legend 2>/dev/null |
		grep -qE '(shutdown|reboot|poweroff|halt|kexec)\.target' || exit 0
fi

speak() {
	[ -e "/proc/asound/$CARD" ] || return 1
	[ -r "$SOUNDS/$file.wav" ] || return 1
	command -v aplay >/dev/null || return 1
	if [ -n "$VOLUME" ] && command -v amixer >/dev/null; then
		amixer -q -c "$CARD" cset name='Master Playback Volume' "$VOLUME" ||:
	fi
	# plughw converts if a WAV is not in the native S16_LE/2ch/48k format
	timeout 15 aplay -q -D "plughw:CARD=$CARD,DEV=0" "$SOUNDS/$file.wav"
}

# One EV_SND event (struct input_event, 64-bit time) per beep
beep_input() {
	dev=
	for n in /sys/class/input/event*; do
		[ "$(cat "$n/device/name" 2>/dev/null)" = qnap-mcu ] || continue
		dev=/dev/input/${n##*/}
	done
	[ -n "$dev" ] && [ -w "$dev" ] || return 1
	command -v python3 >/dev/null || return 1
	for b in $beeps; do
		python3 -I - "$dev" "$b" <<'PY' || return 1
import struct, sys
EV_SYN, EV_SND, SND_BELL, SND_TONE = 0, 0x12, 1, 2
code = SND_TONE if sys.argv[2] == "tone" else SND_BELL
with open(sys.argv[1], "wb", buffering=0) as f:
    f.write(struct.pack("llHHi", 0, 0, EV_SND, code, 1000))
    f.write(struct.pack("llHHi", 0, 0, EV_SYN, 0, 0))
PY
		sleep 0.6
	done
}

# No kernel driver: talk to the MCU directly
beep_mcu() {
	[ -x /usr/local/sbin/qnap-mcu ] || return 1
	for b in $beeps; do
		case $b in tone) /usr/local/sbin/qnap-mcu beep short ;;
			   *) /usr/local/sbin/qnap-mcu beep long ;; esac || return 1
		sleep 0.6
	done
}

speak || beep_input || beep_mcu || exit 1
