From 9f8519d5f34c157c9ac1dcf045cde5fae217d60c Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 36/40] dt-bindings: regulator: Add the GMT G2227 PMIC

The I2C PMIC of the Realtek RTD129x reference designs, with six buck
converters and three LDOs. The rail names are those of the vendor DT.
---
 .../bindings/regulator/gmt,g2227.yaml         | 63 +++++++++++++++++++
 1 file changed, 63 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/regulator/gmt,g2227.yaml

diff --git a/Documentation/devicetree/bindings/regulator/gmt,g2227.yaml b/Documentation/devicetree/bindings/regulator/gmt,g2227.yaml
new file mode 100644
index 000000000..351d8aaee
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/gmt,g2227.yaml
@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/gmt,g2227.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: GMT G2227 power management IC
+
+maintainers:
+  - HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
+
+description: |
+  The G2227 is an I2C PMIC used with the Realtek RTD129x SoCs. It has six
+  step-down converters and three LDOs. In the Realtek reference designs:
+
+    dcdc1: 3.3 V I/O        dcdc2: SCPU (CPU) core   dcdc3: GPU
+    dcdc4: DDR (1.8 V)      dcdc5: ISO domain        dcdc6: core (TOP)
+    ldo1:  RTC              ldo2:  1.8 V             ldo3:  SCPU L2 cache
+
+properties:
+  compatible:
+    const: gmt,g2227
+
+  reg:
+    maxItems: 1
+
+  regulators:
+    type: object
+    additionalProperties: false
+
+    patternProperties:
+      "^(dcdc[1-6]|ldo[1-3])$":
+        type: object
+        $ref: regulator.yaml#
+        unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+  - regulators
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        pmic@12 {
+            compatible = "gmt,g2227";
+            reg = <0x12>;
+
+            regulators {
+                vdd_cpu: dcdc2 {
+                    regulator-name = "vdd_cpu";
+                    regulator-min-microvolt = <800000>;
+                    regulator-max-microvolt = <1100000>;
+                    regulator-always-on;
+                };
+            };
+        };
+    };
