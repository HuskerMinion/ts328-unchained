From 69292f64295849bc8686ed84edb365d34a7220fc Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 17/40] dt-bindings: pwm: Add the Realtek RTD1295 PWM
 controller

Document the four-channel PWM controller in the ISO block of the
Realtek RTD1295 and RTD1296 SoCs. Each channel has a 4-bit power-of-two
prescaler, an 8-bit period divider and an 8-bit duty value, clocked
from the 27 MHz oscillator.
---
 .../bindings/pwm/realtek,rtd1295-pwm.yaml     | 48 +++++++++++++++++++
 1 file changed, 48 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/pwm/realtek,rtd1295-pwm.yaml

diff --git a/Documentation/devicetree/bindings/pwm/realtek,rtd1295-pwm.yaml b/Documentation/devicetree/bindings/pwm/realtek,rtd1295-pwm.yaml
new file mode 100644
index 000000000..739edbd60
--- /dev/null
+++ b/Documentation/devicetree/bindings/pwm/realtek,rtd1295-pwm.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pwm/realtek,rtd1295-pwm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTD1295 PWM controller
+
+maintainers:
+  - HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
+
+description:
+  Four-channel PWM controller in the ISO block of the Realtek RTD1295 and
+  RTD1296 SoCs. Each channel has a 4-bit power-of-two prescaler, an 8-bit
+  period divider and an 8-bit duty value, clocked from the 27 MHz
+  oscillator.
+
+allOf:
+  - $ref: pwm.yaml#
+
+properties:
+  compatible:
+    const: realtek,rtd1295-pwm
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  '#pwm-cells':
+    const: 2
+
+required:
+  - compatible
+  - reg
+  - clocks
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    pwm@980070d0 {
+        compatible = "realtek,rtd1295-pwm";
+        reg = <0x980070d0 0xc>;
+        clocks = <&osc27M>;
+        #pwm-cells = <2>;
+    };
