From f8a5598eec44cfcb71fea9caa1c065cf77ff1999 Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 30/40] dt-bindings: phy: Add the Realtek RTD1295 SATA PHY

Document the two SATA PHYs of the Realtek RTD1293, RTD1295 and RTD1296
SoCs. They are programmed through an MDIO bridge at the end of the SATA
wrapper (0x9803ff60); the analog enables and the chip revision are in
SB2. realtek,tx-amplitude-microvolt selects one of the four TX levels
of the vendor kernels.
---
 .../phy/realtek,rtd1295-sata-phy.yaml         | 73 +++++++++++++++++++
 1 file changed, 73 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/realtek,rtd1295-sata-phy.yaml

diff --git a/Documentation/devicetree/bindings/phy/realtek,rtd1295-sata-phy.yaml b/Documentation/devicetree/bindings/phy/realtek,rtd1295-sata-phy.yaml
new file mode 100644
index 000000000..3d9731f68
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/realtek,rtd1295-sata-phy.yaml
@@ -0,0 +1,73 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/realtek,rtd1295-sata-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTD1295 SATA PHY
+
+maintainers:
+  - HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
+
+description:
+  The two SATA PHYs of the Realtek RTD1293, RTD1295 and RTD1296 SoCs,
+  programmed through an MDIO bridge in the SATA wrapper. The analog
+  enables of both PHYs and the chip revision are in the SB2 block.
+  The PHY cell is the port number.
+
+properties:
+  compatible:
+    const: realtek,rtd1295-sata-phy
+
+  reg:
+    maxItems: 1
+
+  "#phy-cells":
+    const: 1
+
+  resets:
+    maxItems: 4
+
+  reset-names:
+    items:
+      - const: phy0
+      - const: pow0
+      - const: phy1
+      - const: pow1
+
+  realtek,sb2-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: SB2 system controller
+
+  realtek,tx-amplitude-microvolt:
+    description:
+      Maximum TX differential amplitude for Gen1 to Gen3. Without it, the
+      PHY keeps the Gen3 default of the vendor register table.
+    enum: [500000, 573000, 683000, 786000]
+
+required:
+  - compatible
+  - reg
+  - "#phy-cells"
+  - resets
+  - reset-names
+  - realtek,sb2-syscon
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/reset/realtek,rtd1295.h>
+
+    phy@9803ff60 {
+        compatible = "realtek,rtd1295-sata-phy";
+        reg = <0x9803ff60 0xc>;
+        resets = <&reset1 RTD1295_RSTN_SATA_PHY_0>,
+                 <&reset1 RTD1295_RSTN_SATA_PHY_POW_0>,
+                 <&reset4 RTD1295_RSTN_SATA_PHY_1>,
+                 <&reset4 RTD1295_RSTN_SATA_PHY_POW_1>;
+        reset-names = "phy0", "pow0", "phy1", "pow1";
+        realtek,sb2-syscon = <&sb2>;
+        realtek,tx-amplitude-microvolt = <573000>;
+        #phy-cells = <1>;
+    };
