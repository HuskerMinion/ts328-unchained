From 040dfd59415d5080cb469badbf1004a2f5c641e5 Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 26/40] dt-bindings: power: reset: Add Realtek RTD1295 ACPU
 power-off

On the RTD1295/RTD1296 the audio CPU firmware owns the low-power
states, and the system is powered off by asking it to enter its
"coolboot" standby through the RPC shared memory. Wakeup is a cold
boot.

Describe the RPC common area, which must be a no-map region because
the non-coherent audio CPU writes it too, the SB2 syscon with the
SCPU-to-ACPU RPC interrupt, the ISO GPIO lines that wake the system and
their polarity, and "realtek,restart-on-failure" for boards whose boot
loader completes a power-off that was already requested from the board
power controller.
---
 .../reset/realtek,rtd1295-acpu-poweroff.yaml  | 64 +++++++++++++++++++
 1 file changed, 64 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/reset/realtek,rtd1295-acpu-poweroff.yaml

diff --git a/Documentation/devicetree/bindings/power/reset/realtek,rtd1295-acpu-poweroff.yaml b/Documentation/devicetree/bindings/power/reset/realtek,rtd1295-acpu-poweroff.yaml
new file mode 100644
index 000000000..22b0946ef
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/reset/realtek,rtd1295-acpu-poweroff.yaml
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/reset/realtek,rtd1295-acpu-poweroff.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTD1295 power-off through the audio CPU
+
+maintainers:
+  - HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
+
+description:
+  On the Realtek RTD1295 and RTD1296 the audio CPU firmware, started by the
+  boot loader, owns the low-power states. The system is powered off by
+  writing a "coolboot" standby request into the IPC words of the RPC shared
+  memory, after which the audio CPU powers down the main CPU side. Wakeup
+  is a cold boot.
+
+properties:
+  compatible:
+    const: realtek,rtd1295-acpu-poweroff
+
+  memory-region:
+    maxItems: 1
+    description:
+      The RPC common area shared with the audio CPU, a no-map region.
+
+  realtek,sb2:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: SB2 syscon with the SCPU-to-ACPU RPC interrupt register.
+
+  realtek,wakeup-iso-lines:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    maxItems: 35
+    items:
+      maximum: 34
+    description: ISO GPIO lines that wake the system from standby.
+
+  realtek,wakeup-active-low:
+    type: boolean
+    description: The wakeup GPIOs are active low (default active high).
+
+  realtek,restart-on-failure:
+    type: boolean
+    description:
+      Restart the system if the audio CPU does not take over. For boards
+      whose boot loader completes a power-off that was already requested
+      from the board power controller.
+
+required:
+  - compatible
+  - memory-region
+  - realtek,sb2
+
+additionalProperties: false
+
+examples:
+  - |
+    poweroff {
+        compatible = "realtek,rtd1295-acpu-poweroff";
+        memory-region = <&rpc_comm>;
+        realtek,sb2 = <&sb2>;
+        realtek,wakeup-iso-lines = <23>;
+    };
