 	default y
 	help
 	  Support for sound devices specific to ARM architectures.
@@ -28,6 +28,18 @@ config SND_PXA2XX_AC97
 	  Say Y or M if you want to support any AC97 codec attached to
 	  the PXA2xx AC97 interface.
 
+config SND_RTD1295_AO
+	tristate "Realtek RTD1295 audio CPU playback"
+	depends on RTD1295_RPC
+	select SND_PCM
+	help
+	  PCM playback on Realtek RTD1293/RTD1295/RTD1296 SoCs through the
+	  audio CPU firmware, which drives the analog, HDMI and S/PDIF
+	  outputs. One stereo 16-bit stream at 44.1 or 48 kHz.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called snd-rtd1295-ao.
+
 endif	# SND_ARM
 
