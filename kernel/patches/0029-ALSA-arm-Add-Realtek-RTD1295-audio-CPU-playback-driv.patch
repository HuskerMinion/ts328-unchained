index dea2c661b..b0ae96281 100644
--- a/sound/arm/Kconfig
+++ b/sound/arm/Kconfig
@@ -3,7 +3,7 @@
 
 menuconfig SND_ARM
 	bool "ARM sound devices"
-	depends on ARM
