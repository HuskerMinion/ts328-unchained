From 8ddcdcc1b157122b0b7c59f78515799b875c5f8c Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 20/40] thermal: Add the Realtek RTD1295 thermal sensor driver

Add a driver for the CPU temperature sensor of the RTD1295 and RTD1296
SoCs, based on the Realtek BSP 4.9 driver (sensor-rtd129x.c). The
temperature is a 19-bit signed value in 1/1024 degC.

The sensor sometimes stops converting; both vendor kernels then restart
it by rewriting CTRL2, which this driver does as well when the reading
is out of range or STATUS2 reads all-zeros or all-ones.

The trip points and cooling maps come from a device tree thermal zone.
---
 drivers/thermal/Kconfig           |  13 +++
 drivers/thermal/Makefile          |   1 +
 drivers/thermal/rtd1295_thermal.c | 146 ++++++++++++++++++++++++++++++
 3 files changed, 160 insertions(+)
 create mode 100644 drivers/thermal/rtd1295_thermal.c

diff --git a/drivers/thermal/Kconfig b/drivers/thermal/Kconfig
index a09c188b9..d5ed4ba5f 100644
--- a/drivers/thermal/Kconfig
+++ b/drivers/thermal/Kconfig
@@ -488,6 +488,19 @@ config UNIPHIER_THERMAL
 	  thermal framework. The driver supports CPU thermal zone temperature
 	  reporting and a couple of trip points.
 
+config RTD1295_THERMAL
+	tristate "Realtek RTD1295 thermal sensor"
+	depends on ARCH_REALTEK || COMPILE_TEST
+	depends on HAS_IOMEM
+	depends on OF
+	help
+	  Support for the CPU thermal sensor in the Realtek RTD1295 and
+	  RTD1296 SoCs. It reports the temperature to the thermal framework
+	  through a device tree thermal zone.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called rtd1295_thermal.
+
 config SPRD_THERMAL
 	tristate "Temperature sensor on Spreadtrum SoCs"
 	depends on ARCH_SPRD || COMPILE_TEST
diff --git a/drivers/thermal/Makefile b/drivers/thermal/Makefile
index d7718978d..7a2934015 100644
--- a/drivers/thermal/Makefile
+++ b/drivers/thermal/Makefile
@@ -65,6 +65,7 @@ obj-$(CONFIG_GENERIC_ADC_THERMAL)	+= thermal-generic-adc.o
 obj-$(CONFIG_UNIPHIER_THERMAL)	+= uniphier_thermal.o
 obj-$(CONFIG_AMLOGIC_THERMAL)     += amlogic_thermal.o
 obj-$(CONFIG_SPRD_THERMAL)	+= sprd_thermal.o
+obj-$(CONFIG_RTD1295_THERMAL)	+= rtd1295_thermal.o
 obj-$(CONFIG_KHADAS_MCU_FAN_THERMAL)	+= khadas_mcu_fan.o
 obj-$(CONFIG_LOONGSON2_THERMAL)	+= loongson2_thermal.o
 obj-$(CONFIG_THERMAL_CORE_TESTING)	+= testing/
diff --git a/drivers/thermal/rtd1295_thermal.c b/drivers/thermal/rtd1295_thermal.c
new file mode 100644
index 000000000..9e2cc61ed
--- /dev/null
+++ b/drivers/thermal/rtd1295_thermal.c
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Realtek RTD1295/RTD1296 CPU thermal sensor
+ *
+ * Based on the Realtek BSP driver (sensor-rtd129x.c), which is
+ * Copyright (C) 2018 Realtek Semiconductor Corporation
+ * Copyright (C) 2018 Cheng-Yu Lee <cylee12@realtek.com>
+ *
+ * The sensor sits in the SCPU wrapper (DVFS block). STATUS1 holds the
+ * temperature as a 19-bit two's complement value in 1/1024 degC. The
+ * sensor sometimes stops converting; STATUS2 then reads all-zeros or
+ * all-ones and the temperature is out of range. The vendor code recovers
+ * by toggling a bit in CTRL2, which is done here too.
+ */
+
+#include <linux/bits.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/thermal.h>
+
+#include "thermal_hwmon.h"
+
+#define RTD1295_TM_CTRL2		0x08
+#define RTD1295_TM_STATUS1		0x18
+#define RTD1295_TM_STATUS2		0x1c
+
+/* CTRL2 values used by the vendor code to restart the sensor */
+#define RTD1295_TM_CTRL2_STOP		0x01904001
+#define RTD1295_TM_CTRL2_RUN		0x01924001
+
+#define RTD1295_TM_TEMP_SIGN_BIT	18
+#define RTD1295_TM_STATUS2_MASK		GENMASK(21, 0)
+
+/* Plausible range, outside of it the sensor is restarted */
+#define RTD1295_TM_TEMP_MIN		(-30000)
+#define RTD1295_TM_TEMP_MAX		150000
+
+struct rtd1295_thermal {
+	struct device *dev;
+	void __iomem *base;
+};
+
+static void rtd1295_thermal_restart(struct rtd1295_thermal *priv)
+{
+	writel(RTD1295_TM_CTRL2_STOP, priv->base + RTD1295_TM_CTRL2);
+	writel(RTD1295_TM_CTRL2_RUN, priv->base + RTD1295_TM_CTRL2);
+	/* The vendor code waits 25 ms for the first conversion */
+	usleep_range(25000, 26000);
+}
+
+static int rtd1295_thermal_read(struct rtd1295_thermal *priv)
+{
+	u32 val = readl(priv->base + RTD1295_TM_STATUS1);
+	int raw = sign_extend32(val, RTD1295_TM_TEMP_SIGN_BIT);
+
+	/* 1/1024 degC to millidegC */
+	return DIV_ROUND_CLOSEST(raw * 1000, 1024);
+}
+
+static bool rtd1295_thermal_stalled(struct rtd1295_thermal *priv)
+{
+	u32 val = readl(priv->base + RTD1295_TM_STATUS2) &
+		  RTD1295_TM_STATUS2_MASK;
+
+	return val == 0 || val == RTD1295_TM_STATUS2_MASK;
+}
+
+static int rtd1295_thermal_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct rtd1295_thermal *priv = thermal_zone_device_priv(tz);
+	int t = rtd1295_thermal_read(priv);
+
+	if (t < RTD1295_TM_TEMP_MIN || t > RTD1295_TM_TEMP_MAX ||
+	    rtd1295_thermal_stalled(priv)) {
+		dev_dbg(priv->dev, "restarting sensor, temp %d status %08x/%08x\n",
+			t, readl(priv->base + RTD1295_TM_STATUS1),
+			readl(priv->base + RTD1295_TM_STATUS2));
+
+		rtd1295_thermal_restart(priv);
+		t = rtd1295_thermal_read(priv);
+
+		if (t < RTD1295_TM_TEMP_MIN || t > RTD1295_TM_TEMP_MAX ||
+		    rtd1295_thermal_stalled(priv))
+			return -EAGAIN;
+	}
+
+	*temp = t;
+
+	return 0;
+}
+
+static const struct thermal_zone_device_ops rtd1295_thermal_ops = {
+	.get_temp = rtd1295_thermal_get_temp,
+};
+
+static int rtd1295_thermal_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct thermal_zone_device *tz;
+	struct rtd1295_thermal *priv;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = dev;
+
+	priv->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(priv->base))
+		return PTR_ERR(priv->base);
+
+	/* Same as the BSP: start from a known state */
+	rtd1295_thermal_restart(priv);
+
+	tz = devm_thermal_of_zone_register(dev, 0, priv, &rtd1295_thermal_ops);
+	if (IS_ERR(tz))
+		return dev_err_probe(dev, PTR_ERR(tz),
+				     "failed to register thermal zone\n");
+
+	devm_thermal_add_hwmon_sysfs(dev, tz);
+
+	return 0;
+}
+
+static const struct of_device_id rtd1295_thermal_of_match[] = {
+	{ .compatible = "realtek,rtd1295-thermal" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, rtd1295_thermal_of_match);
+
+static struct platform_driver rtd1295_thermal_driver = {
+	.probe = rtd1295_thermal_probe,
+	.driver = {
+		.name = "rtd1295-thermal",
+		.of_match_table = rtd1295_thermal_of_match,
+	},
+};
+module_platform_driver(rtd1295_thermal_driver);
+
+MODULE_DESCRIPTION("Realtek RTD1295 thermal sensor driver");
+MODULE_LICENSE("GPL");
