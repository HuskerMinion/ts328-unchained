+# SPDX-License-Identifier: GPL-2.0-only
+
+menu "Realtek SoC drivers"
+	depends on ARCH_REALTEK || COMPILE_TEST
+
+config RTD129X_RBUS_LOCK
+	bool "Realtek RTD129x eMMC/RBUS erratum serialization"
+	help
+	  RTD1293/RTD1295/RTD1296 SoCs up to revision A01 have a hardware
+	  erratum: an RBUS register access at offsets 0x800-0x9ff within any
+	  4 KiB block that happens while the eMMC controller is active can
+	  corrupt the eMMC transfer. The Realtek vendor kernels serialize
+	  such accesses against eMMC activity with a global lock.
+
+	  This provides that global lock and helpers for drivers that need
+	  it. It is selected by the drivers that use it.
+
+config RTD129X_RBUS_LOCK_DEBUG
+	bool "Debug the RTD129x RBUS erratum lock"
+	depends on RTD129X_RBUS_LOCK
+	help
+	  Record who holds the RTD129x RBUS lock. Warn once when it is held
+	  for more than 1 ms, and report the holder once when a CPU has spun
+	  on it for more than 100 ms (a deadlock or a stalled bus access by
+	  the holder). Costs a clock read per lock/unlock. Say N unless you
+	  are debugging a hang.
+
+config RTD1295_RPC
+	bool "Realtek RTD1295 audio CPU RPC"
+	depends on ARM64
+	depends on ARCH_REALTEK || COMPILE_TEST
+	select GENERIC_ALLOCATOR
+	select MFD_SYSCON
+	help
+	  RPC transport to the audio CPU (ACPU) of the Realtek RTD1293,
+	  RTD1295 and RTD1296. The audio firmware, started by the boot
+	  loader, owns the audio outputs; this provides the shared-memory
+	  rings, the doorbell, and the memory the firmware asks for. It is
+	  needed by the RTD1295 ACPU audio driver.
+
+endmenu
