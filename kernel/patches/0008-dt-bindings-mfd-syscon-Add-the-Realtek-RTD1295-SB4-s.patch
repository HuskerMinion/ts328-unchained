From 24928e9a2c790e8004811e79b9d86f0eb89869c1 Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 08/40] dt-bindings: mfd: syscon: Add the Realtek RTD1295 SB4
 syscon

The SB4 block of the Realtek RTD1293/RTD1295/RTD1296 SoCs holds PCIe
control registers that the vendor PCIe drivers program on early chip
revisions. Add its compatible to the syscon binding so that the PCIe
host controller can reach it through a phandle.
---
 Documentation/devicetree/bindings/mfd/syscon.yaml | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Documentation/devicetree/bindings/mfd/syscon.yaml b/Documentation/devicetree/bindings/mfd/syscon.yaml
index 657c38175..3ba1576cd 100644
--- a/Documentation/devicetree/bindings/mfd/syscon.yaml
+++ b/Documentation/devicetree/bindings/mfd/syscon.yaml
@@ -103,6 +103,7 @@ select:
           - nuvoton,wpcm450-shm
           - qcom,apq8064-mmss-sfpb
           - qcom,apq8064-sps-sic
+          - realtek,rtd1295-sb4
           - rockchip,px30-qos
           - rockchip,rk3036-qos
           - rockchip,rk3066-qos
@@ -212,6 +213,7 @@ properties:
           - nuvoton,wpcm450-shm
           - qcom,apq8064-mmss-sfpb
           - qcom,apq8064-sps-sic
+          - realtek,rtd1295-sb4
           - rockchip,px30-qos
           - rockchip,rk3036-qos
           - rockchip,rk3066-qos
