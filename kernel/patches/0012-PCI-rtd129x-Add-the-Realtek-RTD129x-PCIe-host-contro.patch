diff --git a/drivers/pci/controller/pcie-rtd129x.c b/drivers/pci/controller/pcie-rtd129x.c
new file mode 100644
index 000000000..e69c0991b
--- /dev/null
+++ b/drivers/pci/controller/pcie-rtd129x.c
@@ -0,0 +1,998 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Realtek RTD1293/RTD1295/RTD1296 PCIe host controller driver
+ *
+ * The SoC has two independent single-lane root complexes:
+ *   slot 1: PCIe 1.1 controller at 0x9804e000 (vendor "PCIE0" resources)
+ *   slot 2: PCIe 2.0 controller at 0x9803b000 (vendor "PCIE1" resources)
+ *
+ * The root port is not visible as a PCI bridge. The link partner appears
+ * directly on the root bus and its configuration space is reached through
+ * an indirect access engine in the controller's application registers.
+ * Device BARs live in the 16 MiB memory window of each slot, but the CPU
+ * cannot access that window directly: every device MMIO access goes
+ * through a 4 KiB translated window in the controller (see
+ * asm/rtd129x-pcie-mmio.h and CONFIG_PCIE_RTD129X_MMIO_HOOK).
+ *
+ * Based on the Realtek vendor drivers by James Tai (QNAP GPL 4.2.8
+ * pcie{,2}-rtd1295.c, Realtek BSP 4.9 pcie-rtd129x-slot{1,2}.c, the
+ * latter Copyright (c) 2017 Realtek Semiconductor Corp.) and on the
+ * work-in-progress driver by Andreas Färber, which is
+ * Copyright (c) 2017 Andreas Färber
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/mod_devicetable.h>
+#include <linux/of.h>
+#include <linux/pci.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+#include <linux/soc/realtek/rtd129x-lock.h>
+#include <linux/spinlock.h>
+#include <linux/sizes.h>
+
+#include <asm/rtd129x-pcie-mmio.h>
+
+#include "../pci.h"
+
+/* Root complex configuration space (DBI), DesignWare-like layout */
+#define RTD129X_PCIE_COMMAND		0x004
+#define RTD129X_PCIE_MEM_BASE_LIMIT	0x020
+#define RTD129X_PCIE_PREF_BASE_LIMIT	0x024
+#define RTD129X_PCIE_LNKCTL_LNKSTA	0x080
+#define RTD129X_PCIE_LNKCTL2		0x0a0
+#define  LNKCTL2_TARGET_SPEED		GENMASK(3, 0)
+#define RTD129X_PCIE_PORT_LINK_CTRL	0x710
+
+/* Application ("DVR bridge") registers */
+#define RTD129X_PCIE_SYS_CTR		0xc00
+#define  SYS_CTR_TRAN_EN		BIT(20)
+#define  SYS_CTR_MMIO_TYPE		BIT(19)
+#define  SYS_CTR_PHY_MDIO_OE		BIT(18)
+#define  SYS_CTR_PHY_MDIO_RSTN		BIT(17)
+#define  SYS_CTR_INDIR_CFG_EN		BIT(5)
+#define  SYS_CTR_DIR_CFG_EN		BIT(4)
+#define  SYS_CTR_APP_LTSSM_EN		BIT(1)
+#define RTD129X_PCIE_INDIR_CTR		0xc14
+#define  INDIR_CTR_REQ_FMT		GENMASK(1, 0)
+#define  INDIR_CTR_REQ_TYPE		GENMASK(6, 2)
+#define RTD129X_PCIE_MDIO_CTR		0xc1c
+#define  MDIO_CTR_DATA			GENMASK(31, 16)
+#define  MDIO_CTR_PHY_ADDR		GENMASK(15, 13)
+#define  MDIO_CTR_REG_ADDR		GENMASK(12, 8)
+#define  MDIO_CTR_SRST			BIT(1)
+#define  MDIO_CTR_WRITE			BIT(0)
+#define RTD129X_PCIE_CFG_CT		0xc38
+#define  CFG_CT_GO			BIT(0)
+#define RTD129X_PCIE_CFG_EN		0xc3c
+#define  CFG_EN_BYTE_CNT		GENMASK(7, 4)
+#define  CFG_EN_BYTE_EN			BIT(1)
+#define  CFG_EN_WRITE			BIT(0)
+#define RTD129X_PCIE_CFG_ST		0xc40
+#define  CFG_ST_ERROR			BIT(1)
+#define  CFG_ST_DONE			BIT(0)
+#define RTD129X_PCIE_CFG_ADDR		0xc44
+#define RTD129X_PCIE_CFG_WDATA		0xc48
+#define RTD129X_PCIE_CFG_RDATA		0xc4c
+#define RTD129X_PCIE_DIR_EN		0xc78
+#define  DIR_EN_TIMEOUT_CNT		GENMASK(31, 8)
+#define  DIR_EN_TIMEOUT_EN		BIT(0)
+#define RTD129X_PCIE_RCPL_ST		0xc7c
+#define  RCPL_ST_ERRORS			GENMASK(4, 0)
+#define RTD129X_PCIE_MAC_ST		0xcb4
+#define  MAC_ST_CLK_RDY			BIT(16)
+#define  MAC_ST_LINK_UP			BIT(11)
+#define  MAC_ST_LTSSM			GENMASK(7, 4)
+#define RTD129X_PCIE_PCI_BASE		0xcfc
+#define RTD129X_PCIE_PCI_MASK		0xd00
+#define RTD129X_PCIE_PCI_TRANS		0xd04
+
+/* Indirect config request types (TLP fmt/type) */
+#define INDIR_CTR_CFG_RD0	FIELD_PREP(INDIR_CTR_REQ_TYPE, 0x4)
+#define INDIR_CTR_CFG_WR0	(FIELD_PREP(INDIR_CTR_REQ_TYPE, 0x4) | \
+				 FIELD_PREP(INDIR_CTR_REQ_FMT, 0x2))
+
+/* SB4 registers (0x9801c600), only touched on early chip revisions */
+#define SB4_PCIE_MODE			0x00
+#define SB4_PCIE_CTRL8			0x08
+#define SB4_PCIE_CTRL14			0x14
+
+/* SB2 chip revision register */
+#define SB2_CHIP_REV			0x204
+#define SB2_PCI_BASE0			0x030
+#define RTD129X_REV_A00			0x00000
+#define RTD129X_REV_A01			0x10000
+#define RTD129X_REV_B00			0x20000
+
+#define RTD129X_PCIE_NUM_RESETS		7
+#define RTD129X_PCIE_LINK_TIMEOUT_US	300000
+/*
+ * Config accesses are polled with IRQs off under pcie->lock. A completion
+ * normally arrives within a few microseconds, so give up after 1 ms per
+ * attempt: with the retries below the worst case stays at about 6 ms
+ * (plus 200 us on A00) instead of over a second.
+ */
+#define RTD129X_PCIE_CFG_TIMEOUT_US	1000
+#define RTD129X_PCIE_CFG_RETRIES	5
+
+/* One MDIO write: PHY sub-address, register, 16-bit value */
+#define RTD_PHY(addr, reg, val)					\
+	(FIELD_PREP_CONST(MDIO_CTR_DATA, (val)) |		\
+	 FIELD_PREP_CONST(MDIO_CTR_PHY_ADDR, (addr)) |		\
+	 FIELD_PREP_CONST(MDIO_CTR_REG_ADDR, (reg)) | MDIO_CTR_WRITE)
+
+/* PCIe 1.1 PHY, revisions A00/A01 (QNAP 4.2.8, BSP 4.9 "phys_a") */
+static const u32 rtd129x_pcie_slot1_phy_a[] = {
+	RTD_PHY(0, 0x08, 0x3181),
+	RTD_PHY(0, 0x11, 0xb200),
+	RTD_PHY(0, 0x00, 0x0010),
+};
+
+/* PCIe 1.1 PHY, revision B00 and later (BSP 4.9 "phys_b") */
+static const u32 rtd129x_pcie_slot1_phy_b[] = {
+	RTD_PHY(0, 0x00, 0x0090),
+	RTD_PHY(0, 0x04, 0x4008),
+	RTD_PHY(0, 0x08, 0x5ac1),
+	RTD_PHY(0, 0x0f, 0x32b4),
+	RTD_PHY(0, 0x11, 0x7200),
+};
