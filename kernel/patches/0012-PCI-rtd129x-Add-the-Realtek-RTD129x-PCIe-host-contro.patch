+	}
+
 	if (__builtin_constant_p(count) &&
 	    (count == 8 || count == 4 || count == 2 || count == 1)) {
 		__const_memcpy_toio_aligned64(to, from, count);
diff --git a/arch/arm64/include/asm/rtd129x-pcie-mmio.h b/arch/arm64/include/asm/rtd129x-pcie-mmio.h
new file mode 100644
index 000000000..91741cf26
--- /dev/null
+++ b/arch/arm64/include/asm/rtd129x-pcie-mmio.h
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Realtek RTD129x PCIe memory access hook
+ *
+ * On RTD1295/RTD1296 revision A0x the CPU cannot reach the PCIe memory
+ * windows (0xc0000000-0xc1ffffff) directly: those loads return all ones.
+ * The vendor kernels instead route every access through a translated 4 KiB
+ * window in each controller. With CONFIG_PCIE_RTD129X_MMIO_HOOK, ioremap()
+ * of an address in those windows returns the bus address itself as a cookie,
+ * and the raw MMIO accessors divert cookies to the PCIe driver.
+ *
+ * The hook is compiled out for code that is not linked into, or must not
+ * call into, the kernel proper: the KVM nVHE and VHE hypervisor objects
+ * (which run at EL2 and are linked with a symbol prefix), and the EFI stub
+ * and early position-independent code (built with __DISABLE_EXPORTS).
+ * None of them accesses PCIe memory.
+ */
+#ifndef __ASM_RTD129X_PCIE_MMIO_H
+#define __ASM_RTD129X_PCIE_MMIO_H
+
+#include <linux/compiler.h>
+#include <linux/types.h>
+
+#if defined(CONFIG_PCIE_RTD129X_MMIO_HOOK) &&	\
+	!defined(__KVM_NVHE_HYPERVISOR__) &&		\
+	!defined(__KVM_VHE_HYPERVISOR__) &&		\
+	!defined(__DISABLE_EXPORTS)
+
+#define RTD129X_PCIE_MMIO_START		0xc0000000UL
+#define RTD129X_PCIE_MMIO_SIZE		0x02000000UL
+
+static __always_inline bool
+rtd129x_pcie_mmio_addr(const volatile void __iomem *addr)
+{
+	return unlikely((unsigned long)addr - RTD129X_PCIE_MMIO_START <
+			RTD129X_PCIE_MMIO_SIZE);
+}
+
+u64 rtd129x_pcie_mmio_read(const volatile void __iomem *addr,
+			   unsigned int size);
+void rtd129x_pcie_mmio_write(volatile void __iomem *addr, u64 val,
+			     unsigned int size);
+void __iomem *rtd129x_pcie_mmio_ioremap(phys_addr_t phys, size_t size);
+
+#else
+
+static __always_inline bool
+rtd129x_pcie_mmio_addr(const volatile void __iomem *addr)
+{
+	return false;
+}
+
+static inline u64 rtd129x_pcie_mmio_read(const volatile void __iomem *addr,
+					 unsigned int size)
+{
+	return ~0ULL;
+}
+
+static inline void rtd129x_pcie_mmio_write(volatile void __iomem *addr,
+					   u64 val, unsigned int size)
+{
+}
+
+static inline void __iomem *rtd129x_pcie_mmio_ioremap(phys_addr_t phys,
+						      size_t size)
+{
+	return NULL;
+}
+
+#endif /* CONFIG_PCIE_RTD129X_MMIO_HOOK && !hyp && !__DISABLE_EXPORTS */
+
+#endif /* __ASM_RTD129X_PCIE_MMIO_H */
diff --git a/arch/arm64/mm/ioremap.c b/arch/arm64/mm/ioremap.c
index 1e4794a2a..b97f2714a 100644
--- a/arch/arm64/mm/ioremap.c
+++ b/arch/arm64/mm/ioremap.c
@@ -19,6 +19,10 @@ void __iomem *__ioremap_prot(phys_addr_t phys_addr, size_t size,
 {
 	unsigned long last_addr = phys_addr + size - 1;
 
+	/* RTD129x PCIe windows are reached through the PCIe driver */
+	if (rtd129x_pcie_mmio_addr((const void __iomem *)(unsigned long)phys_addr))
+		return rtd129x_pcie_mmio_ioremap(phys_addr, size);
+
 	/* Don't allow outside PHYS_MASK */
 	if (last_addr & ~PHYS_MASK)
 		return NULL;
