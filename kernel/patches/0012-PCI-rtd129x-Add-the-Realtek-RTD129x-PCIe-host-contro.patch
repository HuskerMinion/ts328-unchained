@@ -190,6 +230,15 @@ void __iowrite32_copy_full(void __iomem *to, const void *from, size_t count);
 static __always_inline void
 __iowrite32_copy(void __iomem *to, const void *from, size_t count)
 {
+	if (rtd129x_pcie_mmio_addr(to)) {
+		u32 __iomem *dst = to;
