 	    (count == 8 || count == 4 || count == 2 || count == 1)) {
 		__const_memcpy_toio_aligned32(to, from, count);
@@ -247,6 +296,15 @@ void __iowrite64_copy_full(void __iomem *to, const void *from, size_t count);
