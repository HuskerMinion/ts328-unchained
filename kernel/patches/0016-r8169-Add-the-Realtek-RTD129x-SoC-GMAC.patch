@@ -2433,9 +2449,42 @@ static void rtl_schedule_task(struct rtl8169_private *tp, enum rtl_flag flag)
 		clear_bit(flag, tp->wk.flags);
 }
 
+/* MAC OCP register gating the PHY interrupts towards the MAC MCU */
+#define RTD129X_OCP_PHY_IRQ_EN		0xfc1e
+#define RTD129X_PHY_IRQ_MASK		(BIT(1) | BIT(11) | BIT(12))
+
+static void rtl_rtd129x_hw_phy_config(struct rtl8169_private *tp)
+{
+	struct phy_device *phydev = tp->phydev;
+	int val;
+
+	/* Keep the MAC MCU off the PHY while it is reconfigured */
+	r8168_mac_ocp_modify(tp, RTD129X_OCP_PHY_IRQ_EN,
+			     RTD129X_PHY_IRQ_MASK, 0);
+	fsleep(1000);
+
+	/* Set dis_mcu_clroob so that ALDPS does not break WoL */
+	RTL_W8(tp, MCU, RTL_R8(tp, MCU) | DIS_MCU_CLROOB);
+
+	/*
+	 * Enable ALDPS like the vendor driver does. Use raw paged access
+	 * so this works with whichever PHY driver bound to the PHY.
+	 */
+	phy_lock_mdio_bus(phydev);
+	__phy_write(phydev, 0x1f, 0x0a43);
+	val = __phy_read(phydev, 0x18);
+	if (val >= 0)
+		__phy_write(phydev, 0x18, val | BIT(2));
+	__phy_write(phydev, 0x1f, 0x0000);
+	phy_unlock_mdio_bus(phydev);
+}
