 static void rtl8169_init_phy(struct rtl8169_private *tp)
 {
-	r8169_hw_phy_config(tp, tp->phydev, tp->mac_version);
+	if (tp->soc_gmac)
+		rtl_rtd129x_hw_phy_config(tp);
+	else
+		r8169_hw_phy_config(tp, tp->phydev, tp->mac_version);
 
 	if (tp->mac_version <= RTL_GIGA_MAC_VER_06) {
 		pci_write_config_byte(tp->pci_dev, PCI_LATENCY_TIMER, 0x40);
@@ -2453,6 +2502,11 @@ static void rtl8169_init_phy(struct rtl8169_private *tp)
 	phy_speed_up(tp->phydev);
 
 	genphy_soft_reset(tp->phydev);
+
+	/* Route the PHY interrupts (link change) to the MAC again */
+	if (tp->soc_gmac)
+		r8168_mac_ocp_modify(tp, RTD129X_OCP_PHY_IRQ_EN, 0,
+				     RTD129X_PHY_IRQ_MASK);
 }
 
