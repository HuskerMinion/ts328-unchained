From 52a98e348130edd135495b0ba570df45e039a7a5 Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 31/40] phy: realtek: Add the RTD129x SATA PHY driver

Program the two SATA PHYs of the RTD1295/RTD1296 through the MDIO
bridge of the SATA wrapper, the way the vendor kernels do it: one write
per parameter bank (Gen1, Gen2, Gen3), 1 ms apart, spread spectrum off,
RX sensitivity by chip revision, then the optional TX amplitude, link
speed auto, PHY power reset release and the SB2 analog enables (bias,
band gap, RX termination; "send_oob" in the vendor code).

The register table is the one of QNAP's 4.2.8 ahci_rtk.c, checked
against the shipped QTS 5.2 kernel for the TS-x28A boards (it has the
0x94a6/0x486a TX writes and no reg 0x15/0x16 writes). The TX levels
are the TX_DRV_TABLE of the Realtek BSP 4.9 phy-rtk-sata.c. On B00
and later the vendor code reads a calibration value from the eFuse for
the Gen1 RX setting; that is not done here.

.init holds the PHY in reset; the AHCI glue keeps it there together
with the port MAC for 100 ms before .power_on, as the vendor code does.
---
 drivers/phy/realtek/Kconfig            |   9 +
 drivers/phy/realtek/Makefile           |   1 +
 drivers/phy/realtek/phy-rtd129x-sata.c | 366 +++++++++++++++++++++++++
 3 files changed, 376 insertions(+)
 create mode 100644 drivers/phy/realtek/phy-rtd129x-sata.c

diff --git a/drivers/phy/realtek/Kconfig b/drivers/phy/realtek/Kconfig
index 75ac7e7c3..ae1a3a070 100644
--- a/drivers/phy/realtek/Kconfig
+++ b/drivers/phy/realtek/Kconfig
@@ -29,4 +29,13 @@ config PHY_RTK_RTD_USB3PHY
 	  DWC3 USB IP. This driver will do the PHY initialization
 	  of the parameters.
 
+config PHY_RTK_RTD129X_SATA
+	tristate "Realtek RTD1295/RTD1296 SATA PHY driver"
+	depends on OF
+	select GENERIC_PHY
+	select MFD_SYSCON
+	help
+	  Enable this to support the two SATA PHYs of the Realtek RTD1293,
+	  RTD1295 and RTD1296 SoCs, used by the AHCI_RTD129X driver.
+
 endif # ARCH_REALTEK || COMPILE_TEST
diff --git a/drivers/phy/realtek/Makefile b/drivers/phy/realtek/Makefile
index ed7b47ff8..73868d4d9 100644
--- a/drivers/phy/realtek/Makefile
+++ b/drivers/phy/realtek/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0
 obj-$(CONFIG_PHY_RTK_RTD_USB2PHY)	+= phy-rtk-usb2.o
 obj-$(CONFIG_PHY_RTK_RTD_USB3PHY)	+= phy-rtk-usb3.o
+obj-$(CONFIG_PHY_RTK_RTD129X_SATA)	+= phy-rtd129x-sata.o
diff --git a/drivers/phy/realtek/phy-rtd129x-sata.c b/drivers/phy/realtek/phy-rtd129x-sata.c
new file mode 100644
index 000000000..03d27c53f
--- /dev/null
+++ b/drivers/phy/realtek/phy-rtd129x-sata.c
@@ -0,0 +1,366 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Realtek RTD1295/RTD1296 SATA PHY
+ *
+ * The two SATA PHYs are programmed through an MDIO bridge at the end of the
+ * SATA wrapper (0x9803ff60): a command register, a PHY select register and
+ * a link speed register. Each PHY has three parameter banks, MDIO PHY
+ * addresses 0, 1 and 2, for Gen1, Gen2 and Gen3. The SB2 block holds the
+ * analog enables (bias, band gap, RX 50 ohm termination) of both PHYs.
+ *
+ * The sequence and the values follow the Realtek vendor kernels: QNAP
+ * 4.2.8 ahci_rtk.c (checked against the binary of the QTS 5.2 kernel for
+ * the TS-x28A boards), Realtek BSP 4.9 phy-rtk-sata.c and Synology 4.4,
+ * and Andreas Färber's WIP ahci_rtd1295.c.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+
+#define RTD129X_SATA_NUM_PHYS		2
+#define RTD129X_SATA_NUM_BANKS		3
+
+/* MDIO bridge, relative to 0x9803ff60 */
+#define MDIO_CTR			0x0
+#define MDIO_CTR_DATA			GENMASK(31, 16)
+#define MDIO_CTR_PHY_ADDR		GENMASK(15, 14)
+#define MDIO_CTR_REG_ADDR		GENMASK(13, 8)
+/* Write command as used by all vendor kernels (bit 0 write, bit 4) */
+#define MDIO_CTR_WRITE_CMD		0x11
+#define MDIO_CTR1			0x4	/* PHY select */
+#define MDIO_SPD			0x8
+#define MDIO_SPD_AUTO			0xa
+
+/* SB2 */
+#define SB2_CHIP_REV			0x204
+#define RTD129X_REV_B00			0x20000
+#define SB2_SATA_PHY_CTRL		0x980
+#define SB2_SATA_BG_EN(n)		BIT(0 + (n))
+#define SB2_SATA_MBIAS_EN(n)		BIT(2 + (n))
+#define SB2_SATA_RX50_LINK(n)		BIT(4 + (n))
+#define SB2_SATA_SGMII_SEL		BIT(8)
+
+/* The vendor code waits 1 ms after every write to the bridge */
+#define RTD129X_SATA_MDIO_DELAY_US	1000
+
+struct rtd129x_sata_mdio {
+	u8 reg;
+	u16 val[RTD129X_SATA_NUM_BANKS];
+};
+
+#define ALL3(v)		{ (v), (v), (v) }
+
+/* QNAP 4.2.8 config_sata_phy(), spread spectrum off */
+static const struct rtd129x_sata_mdio rtd129x_sata_common[] = {
+	{ 0x11, ALL3(0x0000) },
+	{ 0x04, ALL3(0x538e) },		/* spread spectrum off */
+	{ 0x05, ALL3(0x336a) },
+	{ 0x01, { 0xe070, 0xe05c, 0xe04a } },
+	{ 0x06, ALL3(0x0015) },
+	{ 0x0a, ALL3(0xc600) },
+	{ 0x02, ALL3(0x7000) },
+	{ 0x0a, ALL3(0xc660) },
+	{ 0x19, ALL3(0x2004) },
+	{ 0x20, ALL3(0x94aa) },
+};
+
+/* RX sensitivity, revisions A00 and A01 */
+static const struct rtd129x_sata_mdio rtd129x_sata_rx_a0x[] = {
+	{ 0x09, ALL3(0x7210) },
+	{ 0x03, { 0x2771, 0x2768, 0x2766 } },
+};
+
+/*
+ * RX sensitivity and clock delay, revision B00 and later. The vendor code
+ * uses 0x2773 for Gen1 when the eFuse SATA calibration value is 0x16 or
+ * more; the eFuse is not read here.
+ */
+static const struct rtd129x_sata_mdio rtd129x_sata_rx_b0x[] = {
+	{ 0x09, ALL3(0x4210) },
+	{ 0x03, { 0x2771, 0x276d, 0x276d } },
+	{ 0x2a, ALL3(0x7c00) },
+};
+
+static const struct rtd129x_sata_mdio rtd129x_sata_mid[] = {
+	{ 0x10, ALL3(0x2900) },
+};
+
+/* TX amplitude levels (BSP 4.9 TX_DRV_TABLE) */
+struct rtd129x_sata_txdrv {
+	u32 microvolt;
+	struct rtd129x_sata_mdio regs[2];
+};
+
+static const struct rtd129x_sata_txdrv rtd129x_sata_txdrv[] = {
+	{ 500000, { { 0x20, ALL3(0x94a5) }, { 0x21, ALL3(0x385a) } } },
+	{ 573000, { { 0x20, ALL3(0x94a6) }, { 0x21, ALL3(0x486a) } } },
+	{ 683000, { { 0x20, ALL3(0x94a7) }, { 0x21, ALL3(0x587a) } } },
+	{ 786000, { { 0x20, ALL3(0x94aa) }, { 0x21, ALL3(0x88aa) } } },
+};
+
+static const struct rtd129x_sata_mdio rtd129x_sata_post[] = {
+	{ 0x0c, ALL3(0x4000) },		/* RX power saving off */
+	{ 0x17, ALL3(0x0027) },
+};
+
+struct rtd129x_sata_phy;
+
+struct rtd129x_sata_phy_port {
+	struct rtd129x_sata_phy *parent;
+	struct phy *phy;
+	struct reset_control *rst;
+	struct reset_control *pow;
+	unsigned int index;
+};
+
+struct rtd129x_sata_phy {
+	struct device *dev;
+	void __iomem *base;
+	struct regmap *sb2;
+	/* The PHY select register is shared by both PHYs */
+	struct mutex lock;
+	const struct rtd129x_sata_txdrv *txdrv;
+	u32 revision;
+	struct rtd129x_sata_phy_port ports[RTD129X_SATA_NUM_PHYS];
+};
+
+static void rtd129x_sata_mdio_write(struct rtd129x_sata_phy *priv,
+				    const struct rtd129x_sata_mdio *tbl,
+				    unsigned int n)
+{
+	unsigned int i, bank;
+
+	for (i = 0; i < n; i++) {
+		for (bank = 0; bank < RTD129X_SATA_NUM_BANKS; bank++) {
+			writel(FIELD_PREP(MDIO_CTR_DATA, tbl[i].val[bank]) |
+			       FIELD_PREP(MDIO_CTR_PHY_ADDR, bank) |
+			       FIELD_PREP(MDIO_CTR_REG_ADDR, tbl[i].reg) |
+			       MDIO_CTR_WRITE_CMD, priv->base + MDIO_CTR);
+			fsleep(RTD129X_SATA_MDIO_DELAY_US);
+		}
+	}
+}
+
+static int rtd129x_sata_phy_init(struct phy *phy)
+{
+	struct rtd129x_sata_phy_port *port = phy_get_drvdata(phy);
+	int ret;
+
+	/*
+	 * Hold the PHY in reset; the AHCI glue keeps it there together with
+	 * the port MAC for 100 ms before powering it on, as the vendor code
+	 * does.
+	 */
+	ret = reset_control_assert(port->pow);
+	if (ret)
+		return ret;
+
+	return reset_control_assert(port->rst);
+}
+
+static int rtd129x_sata_phy_power_on(struct phy *phy)
+{
+	struct rtd129x_sata_phy_port *port = phy_get_drvdata(phy);
+	struct rtd129x_sata_phy *priv = port->parent;
+	unsigned int n = port->index;
+	int ret;
+
+	ret = reset_control_deassert(port->rst);
+	if (ret)
+		return ret;
+
+	mutex_lock(&priv->lock);
+
+	writel(n, priv->base + MDIO_CTR1);
+	fsleep(RTD129X_SATA_MDIO_DELAY_US);
+
+	rtd129x_sata_mdio_write(priv, rtd129x_sata_common,
+				ARRAY_SIZE(rtd129x_sata_common));
+	if (priv->revision < RTD129X_REV_B00)
+		rtd129x_sata_mdio_write(priv, rtd129x_sata_rx_a0x,
+					ARRAY_SIZE(rtd129x_sata_rx_a0x));
+	else
+		rtd129x_sata_mdio_write(priv, rtd129x_sata_rx_b0x,
+					ARRAY_SIZE(rtd129x_sata_rx_b0x));
+	rtd129x_sata_mdio_write(priv, rtd129x_sata_mid,
+				ARRAY_SIZE(rtd129x_sata_mid));
+	if (priv->txdrv)
+		rtd129x_sata_mdio_write(priv, priv->txdrv->regs,
+					ARRAY_SIZE(priv->txdrv->regs));
+	rtd129x_sata_mdio_write(priv, rtd129x_sata_post,
+				ARRAY_SIZE(rtd129x_sata_post));
+
+	/* Gen1 to Gen3, negotiated */
+	writel(MDIO_SPD_AUTO, priv->base + MDIO_SPD);
+	fsleep(RTD129X_SATA_MDIO_DELAY_US);
+
+	mutex_unlock(&priv->lock);
+
+	ret = reset_control_deassert(port->pow);
+	if (ret)
+		goto err_rst;
+
+	/* Analog enables; the vendor calls this "send_oob" */
+	ret = regmap_set_bits(priv->sb2, SB2_SATA_PHY_CTRL,
+			      SB2_SATA_SGMII_SEL | SB2_SATA_RX50_LINK(n) |
+			      SB2_SATA_MBIAS_EN(n) | SB2_SATA_BG_EN(n));
+	if (ret)
+		goto err_pow;
+
+	dev_dbg(priv->dev, "phy%u powered on\n", n);
+
+	return 0;
+
+err_pow:
+	reset_control_assert(port->pow);
+err_rst:
+	reset_control_assert(port->rst);
+	return ret;
+}
+
+static int rtd129x_sata_phy_power_off(struct phy *phy)
+{
+	struct rtd129x_sata_phy_port *port = phy_get_drvdata(phy);
+	struct rtd129x_sata_phy *priv = port->parent;
+	unsigned int n = port->index;
+
+	/* SGMII_SEL is shared and stays set */
+	regmap_clear_bits(priv->sb2, SB2_SATA_PHY_CTRL,
+			  SB2_SATA_RX50_LINK(n) | SB2_SATA_MBIAS_EN(n) |
+			  SB2_SATA_BG_EN(n));
+	reset_control_assert(port->pow);
+
+	return reset_control_assert(port->rst);
+}
+
+static const struct phy_ops rtd129x_sata_phy_ops = {
+	.init		= rtd129x_sata_phy_init,
+	.power_on	= rtd129x_sata_phy_power_on,
+	.power_off	= rtd129x_sata_phy_power_off,
+	.owner		= THIS_MODULE,
+};
+
+static struct phy *rtd129x_sata_phy_xlate(struct device *dev,
+					  const struct of_phandle_args *args)
+{
+	struct rtd129x_sata_phy *priv = dev_get_drvdata(dev);
+
+	if (args->args_count != 1 ||
+	    args->args[0] >= RTD129X_SATA_NUM_PHYS)
+		return ERR_PTR(-EINVAL);
+
+	return priv->ports[args->args[0]].phy;
+}
+
+static int rtd129x_sata_phy_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct phy_provider *provider;
+	struct rtd129x_sata_phy *priv;
+	unsigned int i;
+	u32 mv;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = dev;
+	ret = devm_mutex_init(dev, &priv->lock);
+	if (ret)
+		return ret;
+
+	priv->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(priv->base))
+		return PTR_ERR(priv->base);
+
+	priv->sb2 = syscon_regmap_lookup_by_phandle(dev->of_node,
+						    "realtek,sb2-syscon");
+	if (IS_ERR(priv->sb2))
+		return dev_err_probe(dev, PTR_ERR(priv->sb2),
+				     "no SB2 syscon\n");
+
+	ret = regmap_read(priv->sb2, SB2_CHIP_REV, &priv->revision);
+	if (ret)
+		return ret;
+
+	if (!of_property_read_u32(dev->of_node, "realtek,tx-amplitude-microvolt",
+				  &mv)) {
+		for (i = 0; i < ARRAY_SIZE(rtd129x_sata_txdrv); i++)
+			if (rtd129x_sata_txdrv[i].microvolt == mv)
+				priv->txdrv = &rtd129x_sata_txdrv[i];
+		if (!priv->txdrv)
+			return dev_err_probe(dev, -EINVAL,
+					     "unsupported TX amplitude %u uV\n",
+					     mv);
+	}
+
+	for (i = 0; i < RTD129X_SATA_NUM_PHYS; i++) {
+		struct rtd129x_sata_phy_port *port = &priv->ports[i];
+		char name[8];
+
+		port->parent = priv;
+		port->index = i;
+
+		snprintf(name, sizeof(name), "phy%u", i);
+		port->rst = devm_reset_control_get_exclusive(dev, name);
+		if (IS_ERR(port->rst))
+			return dev_err_probe(dev, PTR_ERR(port->rst),
+					     "no %s reset\n", name);
+
+		snprintf(name, sizeof(name), "pow%u", i);
+		port->pow = devm_reset_control_get_exclusive(dev, name);
+		if (IS_ERR(port->pow))
+			return dev_err_probe(dev, PTR_ERR(port->pow),
+					     "no %s reset\n", name);
+
+		port->phy = devm_phy_create(dev, NULL, &rtd129x_sata_phy_ops);
+		if (IS_ERR(port->phy))
+			return PTR_ERR(port->phy);
+
+		phy_set_drvdata(port->phy, port);
+	}
+
+	dev_set_drvdata(dev, priv);
+
+	provider = devm_of_phy_provider_register(dev, rtd129x_sata_phy_xlate);
+	if (IS_ERR(provider))
+		return PTR_ERR(provider);
+
+	if (priv->txdrv)
+		dev_info(dev, "chip revision %#x, TX amplitude %u mV\n",
+			 priv->revision, priv->txdrv->microvolt / 1000);
+	else
+		dev_info(dev, "chip revision %#x, default TX amplitude\n",
+			 priv->revision);
+
+	return 0;
+}
+
+static const struct of_device_id rtd129x_sata_phy_of_match[] = {
+	{ .compatible = "realtek,rtd1295-sata-phy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, rtd129x_sata_phy_of_match);
+
+static struct platform_driver rtd129x_sata_phy_driver = {
+	.probe	= rtd129x_sata_phy_probe,
+	.driver	= {
+		.name		= "phy-rtd129x-sata",
+		.of_match_table	= rtd129x_sata_phy_of_match,
+	},
+};
+module_platform_driver(rtd129x_sata_phy_driver);
+
+MODULE_DESCRIPTION("Realtek RTD1295/RTD1296 SATA PHY driver");
+MODULE_LICENSE("GPL");
