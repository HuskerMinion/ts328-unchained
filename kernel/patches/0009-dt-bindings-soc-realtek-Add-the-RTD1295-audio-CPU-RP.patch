From 6cd52454b028495bdad35c55e2769e66e962ef83 Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 09/40] dt-bindings: soc: realtek: Add the RTD1295 audio CPU
 RPC

The RTD1293/RTD1295/RTD1296 audio CPU firmware, started by the boot
loader, owns the audio outputs. The main CPUs talk to it through ring
buffers at fixed addresses in RAM, a doorbell in SB2 and an interrupt
back, and serve the firmware's memory requests.

Describe the ring buffer area and the RPC common area with the IPC
flags, which both must be no-map regions because both CPUs write them,
an optional heap below 512 MiB for the firmware's own allocations, the
interrupt and the SB2 syscon.
---
 .../soc/realtek/realtek,rtd1295-rpc.yaml      | 59 +++++++++++++++++++
 1 file changed, 59 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/realtek/realtek,rtd1295-rpc.yaml

diff --git a/Documentation/devicetree/bindings/soc/realtek/realtek,rtd1295-rpc.yaml b/Documentation/devicetree/bindings/soc/realtek/realtek,rtd1295-rpc.yaml
new file mode 100644
index 000000000..4cce41d6a
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/realtek/realtek,rtd1295-rpc.yaml
@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/realtek/realtek,rtd1295-rpc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTD1295 audio CPU RPC
+
+maintainers:
+  - HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
+
+description:
+  The Realtek RTD1293, RTD1295 and RTD1296 have an audio CPU whose
+  firmware, started by the boot loader, owns the audio outputs. The main
+  CPUs talk to it through ring buffers at fixed addresses in RAM, a
+  doorbell in the SB2 block and an interrupt back. The firmware also asks
+  the main CPUs for memory at run time.
+
+properties:
+  compatible:
+    const: realtek,rtd1295-rpc
+
+  memory-region:
+    minItems: 2
+    items:
+      - description:
+          Ring buffer area at 0x1ffe000. Written by both CPUs, so it must
+          be a no-map region.
+      - description:
+          RPC common area at 0x1f000 (IPC flags). Also written by both
+          CPUs, so it must be a no-map region.
+      - description:
+          Heap for the firmware's own allocations, below 512 MiB, no-map.
+
+  interrupts:
+    maxItems: 1
+    description: Audio CPU to main CPU interrupt.
+
+  realtek,sb2:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: SB2 syscon with the RPC interrupt register.
+
+required:
+  - compatible
+  - memory-region
+  - realtek,sb2
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    rpc {
+        compatible = "realtek,rtd1295-rpc";
+        memory-region = <&rpc_ringbuf>, <&rpc_comm>, <&acpu_heap>;
+        interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
+        realtek,sb2 = <&sb2>;
+    };
