From d85e351b056682dd231279fb32b615b2bb443aca Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 23/40] dt-bindings: mmc: Add the Realtek RTD1295 DesignWare
 MSHC

Document the eMMC controller of the Realtek RTD1293/RTD1295/RTD1296
SoCs: a Synopsys DesignWare MSHC with a Realtek wrapper above offset
0x400. There is no clock driver for these SoCs; the driver programs the
eMMC PLL in the CRT block itself, so the binding takes the CRT and SB2
syscons and a fixed clock-frequency instead of clocks.

realtek,drive-hs gives the pad drive codes used above 26 MHz (the
vendor pddrive_nf_s0 values); below that the vendor init value is used.

realtek,read-only is a bring-up safety switch: the host reports the
card as write-protected and refuses write, erase and write-protect
commands.
---
 .../bindings/mmc/realtek,rtd1295-dw-mshc.yaml | 100 ++++++++++++++++++
 1 file changed, 100 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/mmc/realtek,rtd1295-dw-mshc.yaml

diff --git a/Documentation/devicetree/bindings/mmc/realtek,rtd1295-dw-mshc.yaml b/Documentation/devicetree/bindings/mmc/realtek,rtd1295-dw-mshc.yaml
new file mode 100644
index 000000000..57aadc299
--- /dev/null
+++ b/Documentation/devicetree/bindings/mmc/realtek,rtd1295-dw-mshc.yaml
@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mmc/realtek,rtd1295-dw-mshc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTD1293/RTD1295/RTD1296 eMMC controller
+
+maintainers:
+  - HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
+
+description:
+  The eMMC controller of the Realtek RTD129x SoCs is a Synopsys DesignWare
+  Mobile Storage Host Controller with a Realtek wrapper above offset 0x400.
+  The wrapper routes the interrupt and holds the clock generator, pad mux
+  and pad drive registers. The eMMC PLL is in the CRT block. There is no
+  clock driver for these SoCs, so the driver programs the PLL itself and
+  clock-frequency gives the resulting card interface unit clock.
+
+properties:
+  compatible:
+    const: realtek,rtd1295-dw-mshc
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clock-frequency:
+    const: 100000000
+
+  realtek,crt-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The CRT syscon, which holds the eMMC PLL and clock gates.
+
+  realtek,sb2-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The SB2 syscon, which holds the bus sync and chip revision
+      registers.
+
+  realtek,drive-hs:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description:
+      Pad drive codes used above 26 MHz, for CLK, CMD, DAT0-7 and the data
+      strobe (vendor pddrive_nf_s0). Below that the vendor init value 0x33
+      is used.
+    items:
+      - description: CLK
+        maximum: 0xff
+      - description: CMD
+        maximum: 0xff
+      - description: DAT0-7
+        maximum: 0xff
+      - description: data strobe
+        maximum: 0xff
+    default: [0x77, 0x77, 0x77, 0x33]
+
+  realtek,read-only:
+    type: boolean
+    description:
+      Bring-up safety switch. The host reports the card as write-protected
+      and refuses all write, erase and write-protect commands. The kernel
+      command line option dw_mmc_rtd129x.allow_writes=1 overrides it.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clock-frequency
+  - realtek,crt-syscon
+  - realtek,sb2-syscon
+
+allOf:
+  - $ref: synopsys-dw-mshc-common.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    mmc@98012000 {
+        compatible = "realtek,rtd1295-dw-mshc";
+        reg = <0x98012000 0xa00>;
+        interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
+        clock-frequency = <100000000>;
+        fifo-depth = <128>;
+        realtek,crt-syscon = <&crt>;
+        realtek,sb2-syscon = <&sb2>;
+        bus-width = <8>;
+        cap-mmc-highspeed;
+        max-frequency = <50000000>;
+        realtek,drive-hs = <0x77 0x77 0x77 0x33>;
+        non-removable;
+        no-sd;
+        no-sdio;
+        realtek,read-only;
+    };
+...
