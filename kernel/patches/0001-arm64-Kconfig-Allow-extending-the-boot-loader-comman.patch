From e0d2cf27ce6324e213d648960a326649ca688d65 Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 01/40] arm64: Kconfig: Allow extending the boot loader command
 line

The generic FDT code already appends CONFIG_CMDLINE to the arguments
from the boot loader when CONFIG_CMDLINE_EXTEND is set, but the arm64
command line choice only offers CMDLINE_FROM_BOOTLOADER and
CMDLINE_FORCE.

Some boot loaders pass a fixed command line that cannot be changed
without rebuilding them, such as the vendor U-Boot of the QNAP TS-328
(Realtek RTD1296). Offer CMDLINE_EXTEND so that kernel arguments can be
appended to it.

The early CPU feature override parsing only looks at the boot loader
arguments in this mode, so override options (arm64.* and the ID
register overrides) have no effect in the appended string.
---
 arch/arm64/Kconfig | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 66b7284ce..178fdf97c 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2459,6 +2459,12 @@ config CMDLINE_FROM_BOOTLOADER
 	  the boot loader doesn't provide any, the default kernel command
 	  string provided in CMDLINE will be used.
 
+config CMDLINE_EXTEND
+	bool "Extend bootloader kernel arguments"
+	help
+	  The default kernel command string is appended to the arguments
+	  provided by the boot loader.
+
 config CMDLINE_FORCE
 	bool "Always use the default kernel command string"
 	help
