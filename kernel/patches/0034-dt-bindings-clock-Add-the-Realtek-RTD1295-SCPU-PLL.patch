From a2c0f8203a2a6d4115f9e41eb02ffd05564a00c5 Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 34/40] dt-bindings: clock: Add the Realtek RTD1295 SCPU PLL

The PLL that clocks the Cortex-A53 cluster of the RTD1293, RTD1295 and
RTD1296, in the CRT block (PLL_SSC_DIG_SCPU, 0x500-0x51f). Its output
divider is in the shared CRT PLL_DIV register and is reached through
the parent syscon.
---
 .../clock/realtek,rtd1295-scpu-pll.yaml       | 56 +++++++++++++++++++
 1 file changed, 56 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/realtek,rtd1295-scpu-pll.yaml

diff --git a/Documentation/devicetree/bindings/clock/realtek,rtd1295-scpu-pll.yaml b/Documentation/devicetree/bindings/clock/realtek,rtd1295-scpu-pll.yaml
new file mode 100644
index 000000000..f78e9a26b
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/realtek,rtd1295-scpu-pll.yaml
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/realtek,rtd1295-scpu-pll.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTD1295 SCPU PLL
+
+maintainers:
+  - HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
+
+description:
+  The PLL that clocks the Cortex-A53 cluster (SCPU) of the Realtek
+  RTD1293, RTD1295 and RTD1296 SoCs, in the CRT block. The node covers
+  the PLL_SSC_DIG_SCPU registers. The output divider (scpu_freq_sel) is
+  in the CRT PLL_DIV register at offset 0x30, which is shared with the
+  dividers of other CPUs and is reached through the parent syscon.
+
+properties:
+  compatible:
+    const: realtek,rtd1295-scpu-pll
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: 27 MHz oscillator
+
+  "#clock-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - "#clock-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    syscon@98000000 {
+        compatible = "syscon", "simple-mfd";
+        reg = <0x98000000 0x1800>;
+        #address-cells = <1>;
+        #size-cells = <1>;
+        ranges = <0x0 0x98000000 0x1800>;
+
+        clock-controller@500 {
+            compatible = "realtek,rtd1295-scpu-pll";
+            reg = <0x500 0x20>;
+            clocks = <&osc27M>;
+            #clock-cells = <0>;
+        };
+    };
