From dfaf2267a073c3839c72a51abbfa8750e1dd9ac6 Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 19/40] dt-bindings: thermal: Add the Realtek RTD1295 thermal
 sensor

Document the CPU temperature sensor in the SCPU wrapper of the Realtek
RTD1295 and RTD1296 SoCs.
---
 .../thermal/realtek,rtd1295-thermal.yaml      | 41 +++++++++++++++++++
 1 file changed, 41 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/thermal/realtek,rtd1295-thermal.yaml

diff --git a/Documentation/devicetree/bindings/thermal/realtek,rtd1295-thermal.yaml b/Documentation/devicetree/bindings/thermal/realtek,rtd1295-thermal.yaml
new file mode 100644
index 000000000..cac57bf27
--- /dev/null
+++ b/Documentation/devicetree/bindings/thermal/realtek,rtd1295-thermal.yaml
@@ -0,0 +1,41 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/thermal/realtek,rtd1295-thermal.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTD1295 CPU thermal sensor
+
+maintainers:
+  - HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
+
+description:
+  Temperature sensor in the SCPU wrapper of the Realtek RTD1295 and RTD1296
+  SoCs, next to the CPU cluster.
+
+$ref: thermal-sensor.yaml#
+
+properties:
+  compatible:
+    const: realtek,rtd1295-thermal
+
+  reg:
+    maxItems: 1
+
+  "#thermal-sensor-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - "#thermal-sensor-cells"
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    thermal-sensor@9801d150 {
+        compatible = "realtek,rtd1295-thermal";
+        reg = <0x9801d150 0x1c>;
+        #thermal-sensor-cells = <0>;
+    };
