From 8f00203145b60ff79389dc284d3ab26afde3ef74 Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 11/40] dt-bindings: pci: Add the Realtek RTD1295 PCIe host
 controller

Document the two single-lane PCIe root complexes of the Realtek
RTD1293/RTD1295/RTD1296 SoCs: a PCIe 1.1 controller ("slot 1") and a
PCIe 2.0 controller ("slot 2"). The root port is not exposed as a PCI
bridge, configuration space is reached through an indirect access
engine, and device memory through a translated 4 KiB window in each
controller.

The binding takes the seven controller and PHY resets, an optional
PERST# GPIO, the SB2 syscon for the chip revision, the SB4 syscon that
early chip revisions program, and the CRT syscon for the clock gate,
since there is no RTD129x clock driver yet.
---
 .../bindings/pci/realtek,rtd1295-pcie.yaml    | 136 ++++++++++++++++++
 1 file changed, 136 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/pci/realtek,rtd1295-pcie.yaml

diff --git a/Documentation/devicetree/bindings/pci/realtek,rtd1295-pcie.yaml b/Documentation/devicetree/bindings/pci/realtek,rtd1295-pcie.yaml
new file mode 100644
index 000000000..4c799258c
--- /dev/null
+++ b/Documentation/devicetree/bindings/pci/realtek,rtd1295-pcie.yaml
@@ -0,0 +1,136 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pci/realtek,rtd1295-pcie.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTD1293/RTD1295/RTD1296 PCIe host controller
+
+maintainers:
+  - HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
+
+description:
+  The RTD129x SoCs have two independent single-lane PCIe root complexes,
+  a PCIe 1.1 controller ("slot 1") and a PCIe 2.0 controller ("slot 2").
+  The root port is not exposed as a PCI bridge; the link partner appears
+  directly on the root bus. Configuration space is reached through an
+  indirect access engine in the controller registers, device memory is
+  accessed through a 16 MiB window per slot.
+
+allOf:
+  - $ref: /schemas/pci/pci-host-bridge.yaml#
+
+properties:
+  compatible:
+    enum:
+      - realtek,rtd1295-pcie-slot1
+      - realtek,rtd1295-pcie-slot2
+
+  reg:
+    items:
+      - description: controller (root complex and application) registers
+      - description: translated 4 KiB access window
+
+  reg-names:
+    items:
+      - const: ctrl
+      - const: cfg
+
+  clocks:
+    maxItems: 1
+    description:
+      Controller clock gate. Optional while no RTD129x clock driver exists,
+      see realtek,crt-syscon.
+
+  resets:
+    maxItems: 7
+
+  reset-names:
+    items:
+      - const: stitch
+      - const: pcie
+      - const: core
+      - const: power
+      - const: nonstitch
+      - const: phy
+      - const: phy-mdio
+
+  reset-gpios:
+    maxItems: 1
+    description: PERST# of the slot
+
+  realtek,sb2-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: SB2 syscon, used to read the chip revision
+
+  realtek,sb4-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      SB4 syscon, programmed on RTD129x revision A00 and RTD1296 before
+      revision B00
+
+  realtek,crt-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      CRT syscon. Without a clocks property, the driver sets the slot's
+      clock-enable bit through it if the boot loader left the clock off.
+
+  num-lanes:
+    const: 1
+
+  max-link-speed:
+    enum: [1, 2]
+
+  "#interrupt-cells":
+    const: 1
+
+  interrupt-map-mask: true
+
+  interrupt-map: true
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - resets
+  - reset-names
+  - realtek,sb2-syscon
+  - "#interrupt-cells"
+  - interrupt-map-mask
+  - interrupt-map
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/reset/realtek,rtd1295.h>
+
+    pcie@9803b000 {
+        compatible = "realtek,rtd1295-pcie-slot2";
+        reg = <0x9803b000 0x1000>, <0x9803c000 0x1000>;
+        reg-names = "ctrl", "cfg";
+        device_type = "pci";
+        #address-cells = <3>;
+        #size-cells = <2>;
+        bus-range = <0x01 0xff>;
+        linux,pci-domain = <1>;
+        num-lanes = <1>;
+        max-link-speed = <2>;
+        ranges = <0x02000000 0x0 0xc1000000 0xc1000000 0x0 0x01000000>;
+        #interrupt-cells = <1>;
+        interrupt-map-mask = <0 0 0 0>;
+        interrupt-map = <0 0 0 0 &gic GIC_SPI 62 IRQ_TYPE_LEVEL_HIGH>;
+        resets = <&reset2 RTD1295_RSTN_PCIE1_STITCH>,
+                 <&reset2 RTD1295_RSTN_PCIE1>,
+                 <&reset2 RTD1295_RSTN_PCIE1_CORE>,
+                 <&reset2 RTD1295_RSTN_PCIE1_POWER>,
+                 <&reset2 RTD1295_RSTN_PCIE1_NONSTICH>,
+                 <&reset2 RTD1295_RSTN_PCIE1_PHY>,
+                 <&reset4 RTD1295_RSTN_PCIE1_PHY_MDIO>;
+        reset-names = "stitch", "pcie", "core", "power", "nonstitch",
+                      "phy", "phy-mdio";
+        realtek,sb2-syscon = <&sb2>;
+        realtek,sb4-syscon = <&sb4>;
+        realtek,crt-syscon = <&crt>;
+    };
