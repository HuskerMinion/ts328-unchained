@@ -874,6 +882,27 @@ config MMC_DW_ROCKCHIP
 	  Synopsys DesignWare Memory Card Interface driver. Select this option
 	  for platforms based on RK3066, RK3188 and RK3288 SoC's.
 
+config MMC_DW_RTD129X
+	tristate "Realtek RTD129x specific extensions for Synopsys DW Memory Card Interface"
+	depends on MMC_DW
+	depends on ARCH_REALTEK || COMPILE_TEST
+	depends on OF
+	select MMC_DW_PLTFM
+	select MMC_DW_REG_OPS
+	select MFD_SYSCON
+	select RTD129X_RBUS_LOCK
+	help
+	  This selects support for the eMMC controller of the Realtek
+	  RTD1293, RTD1295 and RTD1296 SoCs, a Synopsys DesignWare MSHC
+	  behind a Realtek wrapper. The glue serializes register accesses
+	  with the RTD129x RBUS erratum lock and programs the eMMC PLL for
+	  a fixed 50 MHz high-speed bus.
+
+	  If the device tree sets "realtek,read-only", the card is reported
+	  as write-protected and all write, erase and write-protect commands
+	  are refused unless the kernel is booted with
+	  dw_mmc_rtd129x.allow_writes=1.
+
