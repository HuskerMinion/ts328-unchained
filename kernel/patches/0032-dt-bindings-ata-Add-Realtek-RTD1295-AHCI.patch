From 086f583ac2750a906da92dcf8daf9006c6d2b814 Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 32/40] dt-bindings: ata: Add Realtek RTD1295 AHCI

Document the two-port AHCI SATA controller of the Realtek RTD1293,
RTD1295 and RTD1296 SoCs. Each port has its own MAC reset and a PHY
from realtek,rtd1295-sata-phy. There is no clock driver for these SoCs,
so the binding takes the CRT syscon for the port clock gates.
---
 .../bindings/ata/realtek,rtd1295-ahci.yaml    | 91 +++++++++++++++++++
 1 file changed, 91 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/ata/realtek,rtd1295-ahci.yaml

diff --git a/Documentation/devicetree/bindings/ata/realtek,rtd1295-ahci.yaml b/Documentation/devicetree/bindings/ata/realtek,rtd1295-ahci.yaml
new file mode 100644
index 000000000..2cb152918
--- /dev/null
+++ b/Documentation/devicetree/bindings/ata/realtek,rtd1295-ahci.yaml
@@ -0,0 +1,91 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/ata/realtek,rtd1295-ahci.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTD1295 AHCI SATA controller
+
+maintainers:
+  - HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
+
+description:
+  Two-port AHCI SATA controller of the Realtek RTD1293, RTD1295 and RTD1296
+  SoCs, with a Realtek wrapper. The PHY MDIO bridge at the end of the
+  wrapper is described by realtek,rtd1295-sata-phy. There is no clock
+  driver for these SoCs; the driver sets the port clock gates in the CRT
+  block itself.
+
+allOf:
+  - $ref: ahci-common.yaml#
+
+properties:
+  compatible:
+    const: realtek,rtd1295-ahci
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  resets:
+    minItems: 1
+    maxItems: 2
+
+  reset-names:
+    minItems: 1
+    items:
+      - const: sata0
+      - const: sata1
+
+  realtek,crt-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: CRT system controller with the SATA clock gates
+
+patternProperties:
+  "^sata-port@[01]$":
+    $ref: /schemas/ata/ahci-common.yaml#/$defs/ahci-port
+    unevaluatedProperties: false
+
+    properties:
+      reg:
+        maximum: 1
+
+    required:
+      - phys
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - resets
+  - reset-names
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/reset/realtek,rtd1295.h>
+
+    sata@9803f000 {
+        compatible = "realtek,rtd1295-ahci";
+        reg = <0x9803f000 0xf60>;
+        interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
+        resets = <&reset1 RTD1295_RSTN_SATA_0>, <&reset4 RTD1295_RSTN_SATA_1>;
+        reset-names = "sata0", "sata1";
+        realtek,crt-syscon = <&crt>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        sata-port@0 {
+            reg = <0>;
+            phys = <&sata_phy 0>;
+        };
+
+        sata-port@1 {
+            reg = <1>;
+            phys = <&sata_phy 1>;
+        };
+    };
