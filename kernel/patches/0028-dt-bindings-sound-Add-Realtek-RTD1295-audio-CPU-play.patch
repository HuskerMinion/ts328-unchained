From cd5aad63c7107967ec0ccc66aab69532d15cf381 Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 28/40] dt-bindings: sound: Add Realtek RTD1295 audio CPU
 playback

PCM playback on the Realtek RTD1293/RTD1295/RTD1296 through the audio
CPU firmware: a no-map reserved pool below 512 MiB for the shared
buffers, the RPC node, and an optional speaker amplifier enable GPIO.
---
 .../sound/realtek,rtd1295-acpu-audio.yaml     | 50 +++++++++++++++++++
 1 file changed, 50 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/realtek,rtd1295-acpu-audio.yaml

diff --git a/Documentation/devicetree/bindings/sound/realtek,rtd1295-acpu-audio.yaml b/Documentation/devicetree/bindings/sound/realtek,rtd1295-acpu-audio.yaml
new file mode 100644
index 000000000..2dcacbbda
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/realtek,rtd1295-acpu-audio.yaml
@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/realtek,rtd1295-acpu-audio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTD1295 playback through the audio CPU
+
+maintainers:
+  - HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
+
+description:
+  PCM playback on the Realtek RTD1293, RTD1295 and RTD1296 through the
+  audio CPU firmware, which drives the SoC audio outputs.
+
+properties:
+  compatible:
+    const: realtek,rtd1295-acpu-audio
+
+  memory-region:
+    maxItems: 1
+    description:
+      A no-map shared-dma-pool below 512 MiB for the buffers the audio CPU
+      reads.
+
+  realtek,rpc:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The audio CPU RPC node.
+
+  enable-gpios:
+    maxItems: 1
+    description: Speaker amplifier enable.
+
+required:
+  - compatible
+  - memory-region
+  - realtek,rpc
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    sound {
+        compatible = "realtek,rtd1295-acpu-audio";
+        memory-region = <&audio_pool>;
+        realtek,rpc = <&acpu_rpc>;
+        enable-gpios = <&misc_gpio 100 GPIO_ACTIVE_HIGH>;
+    };
