From c806a430b487bc305f16153a17d5b66d7f4889cb Mon Sep 17 00:00:00 2001
From: HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 15/40] dt-bindings: net: Add the Realtek RTD1295 GMAC

The Realtek RTD1293/RTD1295/RTD1296 SoCs integrate an RTL8168g family
Gigabit Ethernet MAC with an embedded PHY on the SoC register bus. The
vendor kernels describe it as "Realtek,r8168" with vendor properties.
Describe the MAC, its MAC and PHY resets and the ISO syscon that holds
its clock gates and power-up controls.
---
 .../bindings/net/realtek,rtd1295-gmac.yaml    | 67 +++++++++++++++++++
 1 file changed, 67 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/net/realtek,rtd1295-gmac.yaml

diff --git a/Documentation/devicetree/bindings/net/realtek,rtd1295-gmac.yaml b/Documentation/devicetree/bindings/net/realtek,rtd1295-gmac.yaml
new file mode 100644
index 000000000..ea96d380a
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/realtek,rtd1295-gmac.yaml
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/realtek,rtd1295-gmac.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTD129x SoC integrated Gigabit Ethernet MAC
+
+maintainers:
+  - HuskerMinion <28571744+HuskerMinion@users.noreply.github.com>
+
+description:
+  The Realtek RTD1293, RTD1295 and RTD1296 SoCs integrate an RTL8168g
+  family Gigabit Ethernet MAC with an embedded PHY. It sits on the SoC
+  register bus instead of PCIe and is handled by the r8169 driver.
+
+allOf:
+  - $ref: ethernet-controller.yaml#
+
+properties:
+  compatible:
+    const: realtek,rtd1295-gmac
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  resets:
+    items:
+      - description: MAC reset
+      - description: embedded PHY reset
+
+  reset-names:
+    items:
+      - const: gmac
+      - const: gphy
+
+  realtek,iso-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the ISO block syscon, used to power up the GMAC (clock
+      gates, GPHY bypass mode and DBUS clock gating) when the boot loader
+      left it off.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/reset/realtek,rtd1295.h>
+
+    ethernet@98016000 {
+        compatible = "realtek,rtd1295-gmac";
+        reg = <0x98016000 0x1000>;
+        interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
+        resets = <&iso_reset RTD1295_ISO_RSTN_GMAC>,
+                 <&iso_reset RTD1295_ISO_RSTN_GPHY>;
+        reset-names = "gmac", "gphy";
+        realtek,iso-syscon = <&iso>;
+    };
