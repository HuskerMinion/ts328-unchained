From 03b8fd4b16cba1094d3ff90a382a835f70002102 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andreas=20F=C3=A4rber?= <afaerber@suse.de>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH 02/40] dt-bindings: interrupt-controller: Add Realtek RTD1195
 IRQ mux
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add a binding for the ISO and MISC interrupt muxes found on Realtek
RTD1195, RTD1295/RTD1296, RTD1395 and RTD1619 SoCs. Each mux combines
the interrupts of low-speed peripherals (UART, I2C, GPIO, RTC, IR, ...)
into one GIC SPI. The one-cell specifier is the source's bit index in
the block's interrupt status register.

Ported from Andreas Färber's work-in-progress RTD1295 tree to Linux
6.18. Changes in the port: a top-level description and
unevaluatedProperties are added, the compatibles are sorted, the title
and the interrupts description are reworded, and the license is now
(GPL-2.0-only OR BSD-2-Clause), which the original (GPL-2.0-or-later OR
BSD-2-Clause) permits.
---
 .../realtek,rtd1195-mux.yaml                  | 65 +++++++++++++++++++
 1 file changed, 65 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/interrupt-controller/realtek,rtd1195-mux.yaml

diff --git a/Documentation/devicetree/bindings/interrupt-controller/realtek,rtd1195-mux.yaml b/Documentation/devicetree/bindings/interrupt-controller/realtek,rtd1195-mux.yaml
new file mode 100644
index 000000000..f34f2cb0a
--- /dev/null
+++ b/Documentation/devicetree/bindings/interrupt-controller/realtek,rtd1195-mux.yaml
@@ -0,0 +1,65 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interrupt-controller/realtek,rtd1195-mux.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTD1195/RTD1295 ISO and MISC IRQ mux
+
+maintainers:
+  - Andreas Färber <afaerber@suse.de>
+
+description:
+  The ISO and MISC register blocks of Realtek DHC SoCs each combine the
+  interrupts of several low-speed peripherals (UART, I2C, GPIO, RTC, IR,
+  ...) into one GIC interrupt. The interrupt specifier is the index of the
+  source's bit in the block's interrupt status (ISR) register.
+
+allOf:
+  - $ref: /schemas/interrupt-controller.yaml#
+
+properties:
+  compatible:
+    enum:
+      - realtek,rtd1195-iso-irq-mux
+      - realtek,rtd1195-misc-irq-mux
+      - realtek,rtd1295-iso-irq-mux
+      - realtek,rtd1295-misc-irq-mux
+      - realtek,rtd1395-iso-irq-mux
+      - realtek,rtd1395-misc-irq-mux
+      - realtek,rtd1619-iso-irq-mux
+      - realtek,rtd1619-misc-irq-mux
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    description: The GIC interrupt that the mux outputs.
+    maxItems: 1
+
+  interrupt-controller: true
+
+  "#interrupt-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - interrupt-controller
+  - "#interrupt-cells"
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    interrupt-controller@98007000 {
+        compatible = "realtek,rtd1295-iso-irq-mux";
+        reg = <0x98007000 0x100>;
+        interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-controller;
+        #interrupt-cells = <1>;
+    };
+...
