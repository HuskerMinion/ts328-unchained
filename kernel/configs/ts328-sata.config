# SPDX-License-Identifier: GPL-2.0-only
# SoC SATA for the QNAP TS-328 drive bays 1 and 2 (on top of ts328-pcie.config,
# which has SCSI, BLK_DEV_SD, ATA and the ASMedia AHCI for bay 3)
CONFIG_ATA=y
CONFIG_SATA_HOST=y
CONFIG_AHCI_RTD129X=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_RTK_RTD129X_SATA=y
CONFIG_MFD_SYSCON=y
CONFIG_RESET_CONTROLLER=y
