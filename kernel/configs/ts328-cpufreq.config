# SPDX-License-Identifier: GPL-2.0-only
# TS-328 CPU frequency and voltage scaling: SCPU PLL, G2227 CPU rail,
# cpufreq-dt with OPPs from DT, and the CPUs as thermal cooling devices.
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_RTD129X_SCPU=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_G2227=y
CONFIG_PM_OPP=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y
# Test aid: /sys/class/thermal/thermal_zone0/emul_temp (root only)
CONFIG_THERMAL_EMULATION=y
