# SPDX-License-Identifier: GPL-2.0-only
# USB host for the QNAP TS-328 (on top of ts328-pcie.config)
# Three DWC3 controllers (DRD, USB 2.0 host, USB 3.0 host) in host mode
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_RTK=y
CONFIG_PHY_RTK_RTD_USB2PHY=y
CONFIG_PHY_RTK_RTD_USB3PHY=y
# VBUS enables (ISO GPIO 1 and 32) as always-on fixed regulators
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# USB mass storage, usable as root (SCSI disk and ext4 come from ts328-pcie)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
