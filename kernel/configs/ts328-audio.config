# TS-328 speaker: RPC to the audio CPU firmware and ALSA playback through it.
CONFIG_RTD1295_RPC=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_ARM=y
CONFIG_SND_RTD1295_AO=y
# CONFIG_SND_DRIVERS is not set
# CONFIG_SND_PCI is not set
# CONFIG_SND_USB is not set
# CONFIG_SND_SOC is not set
