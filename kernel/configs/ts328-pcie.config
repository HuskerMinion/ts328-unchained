# SPDX-License-Identifier: GPL-2.0-only
# PCIe host (both RTD129x slots) + the devices behind them on the TS-328
CONFIG_PCI=y
CONFIG_PCIE_RTD129X=y
CONFIG_RTD129X_RBUS_LOCK=y
CONFIG_MFD_SYSCON=y
# GPIO for PERST# once the misc GPIO controller is usable (optional today)
CONFIG_GPIOLIB=y
# Slot 2: ASMedia ASM106x SATA AHCI (drive bays)
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
# Slot 1: Realtek RTL8111/8168 (LAN1)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
CONFIG_PCIE_RTD129X_MMIO_HOOK=y
