# SPDX-License-Identifier: GPL-2.0-only
# TS-328 platform: thermal sensor, SoC PWM (drive LEDs), front-panel MCU
# (power-off, LEDs, buzzer, fan, power button), front buttons.
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_HWMON=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_RTD1295_THERMAL=y
CONFIG_HWMON=y
CONFIG_PWM=y
CONFIG_PWM_RTD1295=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_MFD_QNAP_MCU=y
CONFIG_SENSORS_QNAP_MCU_HWMON=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_QNAP_MCU=y
CONFIG_LEDS_PWM=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_PATTERN=y
CONFIG_LEDS_TRIGGER_DISK=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_QNAP_MCU=y
CONFIG_SENSORS_DRIVETEMP=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_RTD1295_ACPU=y
