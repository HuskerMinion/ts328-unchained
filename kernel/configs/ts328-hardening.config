# SPDX-License-Identifier: GPL-2.0-only
# Hardening, close to Debian's arm64 kernel.
# - KASLR is left out: the vendor U-Boot provides no seed, and booti places
#   the kernel at a fixed offset.
# - INIT_ON_ALLOC is left off by default, as in Debian, for its memory
#   bandwidth cost on this SoC; boot with init_on_alloc=1 to enable it.
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_LIST_HARDENED=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
CONFIG_AUDIT=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,apparmor,bpf"
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_LEGACY_TIOCSTI=n
# SysRq: only sync, remount read-only and reboot (kernel.sysrq=176)
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0xb0
