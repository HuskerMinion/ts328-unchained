# LAN2: RTD129x SoC-integrated GMAC through the r8169 platform front end
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_R8169_RTD129X=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
CONFIG_MFD_SYSCON=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_SIMPLE=y
