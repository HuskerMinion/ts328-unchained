# SPDX-License-Identifier: GPL-2.0-only
# eMMC (98012000): dw_mmc + RTD129x glue, built in, plus the MMC block layer.
# The board DT keeps the card read-only (realtek,read-only); boot with
# dw_mmc_rtd129x.allow_writes=1 to lift that.
CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=16
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_RTD129X=y
CONFIG_MFD_SYSCON=y
CONFIG_RTD129X_RBUS_LOCK=y
# The eMMC uses an MBR with an extended partition (p4 < p5 p6 p7 >)
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
# Hang diagnostics (round 2): report soft/hard lockups and hung tasks,
# panic on them so the watchdog restarts the box (log in ramoops), and use
# a 10 s RCU stall timeout. hung_task_panic=0 / softlockup_panic=0 on the
# command line turn the panics off.
CONFIG_DEBUG_KERNEL=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_PREFER_BUDDY=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_RCU_CPU_STALL_TIMEOUT=10
CONFIG_PANIC_TIMEOUT=10
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y
