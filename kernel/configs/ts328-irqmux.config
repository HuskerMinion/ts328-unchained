# SPDX-License-Identifier: GPL-2.0-only
# Low-speed peripherals for the QNAP TS-328 (on top of ts328-phase1.config)
# ISO/MISC interrupt mux (UART, I2C, GPIO interrupts)
CONFIG_RTD1195_IRQ_MUX=y
# GPIO
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_RTD=y
# I2C
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
# RTC: Epson RX8010 on i2c4 is the system RTC (rtc0); SoC RTC driver is
# built in but its DT node stays disabled on the TS-328
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_SYSTOHC_DEVICE="rtc0"
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_DRV_RX8010=y
CONFIG_RTC_DRV_RTD119X=y
# /dev/mem for register checks during bring-up (clock gates, pinmux)
CONFIG_DEVMEM=y
# Interim pin muxing for I2C0/I2C4 (pinctrl-single in the board DT)
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SINGLE=y
